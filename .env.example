# Public values only. Never put secrets here: everything with EXPO_PUBLIC_ is bundled into the app.
# Licence verification public key (Ed25519, 64 hex chars). The private key lives only in the Worker.
EXPO_PUBLIC_LICENCE_PUBLIC_KEY=
# Base URL of the Cloudflare Worker (purchase verification, event packs, Family Circle relay).
EXPO_PUBLIC_API_BASE_URL=
# Opt-in crash reporting and analytics (empty disables them).
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
