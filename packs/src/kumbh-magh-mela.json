      },
      "phrase": "मैं खो गया हूँ",
      "lang": "hi",
      "transliteration": "main kho gaya hoon"
    },
    {
      "meaning": {
        "en": "Please help me"
      },
      "phrase": "कृपया मेरी मदद कीजिए",
      "lang": "hi",
      "transliteration": "kripya meri madad kijiye"
    },
    {
      "meaning": {
        "en": "Where is the lost and found centre?"
      },
      "phrase": "खोया-पाया केंद्र कहाँ है?",
