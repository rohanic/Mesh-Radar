      "transliteration": "yah kaun sa sector hai?"
    }
  ],
  "checklist": [
    {
      "en": "Every group member has the app, has joined the group and has filled in their emergency card."
    },
    {
      "en": "Children carry a printed lost-child card."
    },
    {
      "en": "Sector, ghat and camp saved as meeting points."
    },
    {
      "en": "Dry clothes in a plastic bag, a towel and a power bank."
    },
    {
      "en": "Practice an SOS together and run one regroup drill before you travel."
    }
  ],
