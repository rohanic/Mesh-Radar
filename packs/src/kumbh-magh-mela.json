  "meetingPoints": [
    {
      "name": {
        "en": "Your sector and ghat number"
      },
      "detail": {
        "en": "Mela areas are split into numbered or colour coded sectors, and ghats are numbered. Save yours as soon as you arrive."
      }
    },
    {
      "name": {
        "en": "A lost and found centre"
      },
      "detail": {
        "en": "At Maha Kumbh 2025 the mela authority ran lost and found centres across the mela area where people without a phone could call family. Note the nearest one."
      }
    },
    {
      "name": {
        "en": "A pontoon bridge end"
      },
      "detail": {
        "en": "Pick one end of a named bridge, not the middle."
      }
    },
    {
      "name": {
        "en": "Ramkund or Kushavarta"
      },
      "detail": {
        "en": "The main bathing places at the Nashik-Trimbakeshwar Simhastha."
      }
    }
  ],
  "dos": [
    {
      "en": "Go to bathe early on the big days, or on a quieter day if you can."
    },
    {
      "en": "Agree on a ghat and a time to meet after bathing."
    },
    {
      "en": "Keep elders and children on the side of the ghat, away from the steps where people push down."
    },
    {
      "en": "Find the exits and a second way out as soon as you arrive."
    },
    {
      "en": "In a dense crowd, keep your hands up near your chest to protect your breathing."
    },
    {
      "en": "Move with the flow and work your way diagonally toward the edge."
    },
    {
      "en": "If you fall, get up fast. If you cannot, curl up on your side and cover your head with your arms."
    }
  ],
  "donts": [
    {
      "en": "Don't stop on bridges, steps or narrow approach roads."
    },
    {
      "en": "Don't go into deep water: stay within the ropes and barricades."
    },
    {
      "en": "Don't push against the flow of a crowd, and don't stop or sit down in it."
    },
    {
      "en": "Don't stand against walls, fences or barricades when a crowd is dense."
    }
  ],
  "schedule": [
    {
      "title": {
        "en": "Haridwar Ardh Kumbh 2027 bathing days"
      },
      "detail": {
        "en": "14 Jan, 6 Feb, 11 Feb, 20 Feb, 6 Mar, 8 Mar, 7 Apr, 14 Apr, 15 Apr and 20 Apr. Amrit Snans are 6 Mar, 8 Mar and 14 Apr."
      }
    },
    {
      "title": {
        "en": "The Sangam at Prayagraj"
      },
      "detail": {
        "en": "Where the Ganga and Yamuna meet, about 7 km from Civil Lines. Boats leave from the ghat near the fort."
      }
    }
  ],
  "phrasebook": [
    {
      "meaning": {
