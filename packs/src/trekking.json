  "meetingPoints": [
    {
      "name": {
        "en": "Tonight's lodge or camp"
      },
      "detail": {
        "en": "Save it as a meeting point every morning before you set off."
      }
    },
    {
      "name": {
        "en": "Each trail junction"
      },
      "detail": {
        "en": "The leader can add checkpoints with deadlines in the app."
      }
    },
    {
      "name": {
        "en": "A Himalayan Rescue Association aid post"
      },
      "detail": {
        "en": "On the Everest route at Pheriche and on the Annapurna route at Manang, staffed in spring and autumn."
      }
    }
  ],
  "dos": [
    {
      "en": "Set a check-in timer before every day on the trail."
    },
    {
      "en": "Keep the slowest walker in the middle of the group, not at the back."
    },
    {
      "en": "Check permit rules before you go: in parts of Nepal you need a licensed guide and a TIMS card."
    },
    {
      "en": "Register your trek with the tourism department in Gilgit-Baltistan."
    },
    {
      "en": "Climb slowly and rest when anyone has a headache, nausea or dizziness at altitude."
    }
  ],
  "donts": [
    {
      "en": "Don't leave the trail to take a shortcut, especially in fog or snow."
    },
    {
      "en": "Don't split the group without agreeing where and when you will meet again."
    },
    {
      "en": "Don't keep climbing with symptoms of altitude sickness."
    }
  ],
  "schedule": [
    {
      "title": {
        "en": "Seasons"
      },
      "detail": {
        "en": "The Nepal Tourism Board lists spring (March to May) and autumn (September to November) as the best months for the Annapurna area. Other areas differ."
      }
    }
  ],
